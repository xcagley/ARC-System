using Microsoft.Data.SqlClient;
namespace SQL_Connection
{
    public class SQLConn
    {
        public string connectionString { get; set; }
        public SQLConn()
        {
            connectionString = @"Server=*Server Name(Sometimes local machine)*;Database=*Database used*;Trusted_Connection=True;TrustServerCertificate=True;";
            //Trusted_Connection and TrustServerCertificate are here as the database is held on the local machine. Otherwise, the variables are user: and password: requiring sign-in values

        }
    }
