            //During the creation/build, this will probably be ran when the start button is clicked
            //Start button will be used as a placeholder for turning on the ARC Band
            SQLConn connectionString = new SQLConn();
            var connection = new SqlConnection(connectionString.connectionString);
            connection.Open();


